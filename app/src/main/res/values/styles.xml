<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="FiturItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">#1A1A1A</item>
        <item name="android:padding">12dp</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>
    <style name="FiturLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="FiturStatus">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#FF1744</item>
        <item name="android:textSize">14sp</item>
        <item name="android:layout_marginEnd">8dp</item>
    </style>
    <style name="FiturSwitch">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:thumbTint">#FF1744</item>
        <item name="android:trackTint">#333333</item>
    </style>
    <style name="FiturButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#00FF41</item>
        <item name="android:background">@null</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>
