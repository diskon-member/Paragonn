<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="160dp"
    android:background="@drawable/dragon_card_bg"
    android:orientation="vertical"
    android:padding="14dp"
    android:layout_margin="6dp"
    android:radius="14dp"
    android:elevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/ivIcon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="#1A0000"
            android:gravity="center"
            android:text="🔦"
            android:textSize="18sp"
            android:radius="10dp"
            android:padding="8dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Switch
            android:id="@+id/swFitur"
            android:layout_width="44dp"
            android:layout_height="24dp"
            android:thumbTint="#FFFFFF"
            android:trackTint="#2A3A5C"
            android:visibility="gone" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/tvNamaFitur"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Flashlight"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif" />

    <TextView
        android:id="@+id/tvStatusFitur"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="OFF"
        android:textColor="#8B0000"
        android:textSize="11sp"
        android:fontFamily="sans-serif" />

    <Button
        android:id="@+id/btnAction"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:background="@drawable/dragon_btn"
        android:text="TAP"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:radius="15dp"
        android:fontFamily="sans-serif"
        android:visibility="gone" />

</LinearLayout>
