<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#121C30"
    android:orientation="horizontal"
    android:padding="14dp"
    android:layout_marginBottom="8dp"
    android:radius="14dp"
    android:elevation="2dp"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/ivTargetIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_phone"
        android:background="#1A263A"
        android:padding="12dp"
        android:radius="12dp"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="14dp">

        <TextView
            android:id="@+id/tvTargetName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="vivo Y20s"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvTargetDevice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ID: 1e5b8925ea01bef1"
            android:textColor="#7A8A9E"
            android:textSize="11sp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/tvTargetStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🟢 ONLINE"
                android:textColor="#00E5FF"
                android:textSize="11sp"/>

            <TextView
                android:id="@+id/tvTargetBattery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="78%"
                android:textColor="#7A8A9E"
                android:textSize="11sp"
                android:layout_marginStart="12dp"/>

        </LinearLayout>

    </LinearLayout>

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_arrow_right"
        android:tint="#7A8A9E"
        android:layout_gravity="center_vertical"/>

</LinearLayout>
