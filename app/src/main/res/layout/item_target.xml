<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dragon_card_bg"
    android:orientation="horizontal"
    android:padding="14dp"
    android:layout_marginBottom="8dp"
    android:radius="14dp"
    android:elevation="4dp"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="#1A0000"
        android:gravity="center"
        android:text="📱"
        android:textSize="24sp"
        android:radius="12dp"
        android:padding="12dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="14dp">

        <TextView
            android:id="@+id/tvTargetName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="vivo Y20s"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif" />

        <TextView
            android:id="@+id/tvTargetDevice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ID: 1e5b8925ea01bef1"
            android:textColor="#8B0000"
            android:textSize="11sp"
            android:fontFamily="sans-serif" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/tvTargetStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🟢 ONLINE"
                android:textColor="#FF1A1A"
                android:textSize="11sp"
                android:fontFamily="sans-serif" />

            <TextView
                android:id="@+id/tvTargetBattery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="78%"
                android:textColor="#FFD700"
                android:textSize="11sp"
                android:fontFamily="sans-serif"
                android:layout_marginStart="12dp" />

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:text="›"
        android:textColor="#8B0000"
        android:textSize="20sp"
        android:gravity="center" />

</LinearLayout>
