<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="160dp"
    android:background="@drawable/card_fitur_bg"
    android:orientation="vertical"
    android:padding="18dp"
    android:layout_margin="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_flashlight"
            android:background="@drawable/icon_bg"
            android:padding="12dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Switch
            android:id="@+id/swFitur"
            android:layout_width="46dp"
            android:layout_height="26dp"
            android:thumbTint="#FFFFFF"
            android:trackTint="#2A3A5C" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/tvNamaFitur"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Flashlight"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif" />

    <TextView
        android:id="@+id/tvStatusFitur"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="OFF"
        android:textColor="#FF5C7C"
        android:textSize="12sp"
        android:fontFamily="sans-serif" />

    <!-- Button untuk fitur non-toggle (default hidden) -->
    <Button
        android:id="@+id/btnAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TAP"
        android:textColor="#FFFFFF"
        android:background="@drawable/primary_btn_bg"
        android:textSize="12sp"
        android:visibility="gone" />

</LinearLayout>
