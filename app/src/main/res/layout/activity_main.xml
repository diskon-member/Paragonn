<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090F1D"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/hero_card_bg"
        android:padding="16dp"
        android:layout_marginBottom="16dp">

        <!-- Baris 1: Nama Device + ID -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDeviceName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="2409BRN2CY"
                android:textColor="#00FF41"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDeviceId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="d9d393e8446f578b"
                android:textColor="#888888"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Baris 2: Status ONLINE + Tombol PILIH TARGET -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ONLINE"
                android:textColor="#00FF41"
                android:textSize="14sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnGanti"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="📱 PILIH TARGET"
                android:textColor="#00FF41"
                android:background="#1A1A1A"
                android:textSize="12sp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

        </LinearLayout>

        <!-- Anti Uninstall -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Anti Uninstall"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvAntiUninstallText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OFF"
                android:textColor="#FF1744"
                android:textSize="14sp"
                android:layout_marginEnd="8dp" />

            <Switch
                android:id="@+id/swAntiUninstall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:thumbTint="#FF1744"
                android:trackTint="#333333" />

        </LinearLayout>

        <!-- Device Info 2 -->
        <TextView
            android:id="@+id/tvDeviceName2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2409BRN2CY"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvDeviceId2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="d9d393e8446f578b"
            android:textColor="#888888"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvBattery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="11%"
            android:textColor="#00FF41"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- KONTROL DEVICE -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="KONTROL DEVICE"
        android:textColor="#00FF41"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- GRID 2 KOLOM -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Baris 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <include
                layout="@layout/card_fitur"
                android:id="@+id/cardFlashlight"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp" />

            <include
                layout="@layout/card_fitur"
                android:id="@+id/cardLockLow"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <!-- Baris 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <include
                layout="@layout/card_fitur"
                android:id="@+id/cardLockCustom"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp" />

            <include
                layout="@layout/card_fitur"
                android:id="@+id/cardTemaPhising"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <!-- Baris 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <include
                layout="@layout/card_fitur"
                android:id="@+id/cardHideIcon"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp" />

            <include
                layout="@layout/card_fitur"
                android:id="@+id/cardVideoOverlay"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <!-- Baris 4 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <include
                layout="@layout/card_fitur"
                android:id="@+id/cardSpamNotif"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp" />

            <include
                layout="@layout/card_fitur"
                android:id="@+id/cardStuckLayar"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <!-- Baris 5 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <include
                layout="@layout/card_fitur"
                android:id="@+id/cardGPS"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp" />

            <include
                layout="@layout/card_fitur"
                android:id="@+id/cardKamera"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <!-- Baris 6 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <include
                layout="@layout/card_fitur"
                android:id="@+id/cardRansomware"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp" />

            <include
                layout="@layout/card_fitur"
                android:id="@+id/cardNgehang"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- GANTI SERVER -->
    <EditText
        android:id="@+id/etServerUrl"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Masukkan URL server baru..."
        android:textColor="#FFFFFF"
        android:textColorHint="#666666"
        android:background="#1A1A1A"
        android:padding="12dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnSetServer"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="GANTI SERVER"
        android:textColor="#0A0A0A"
        android:background="#00FF41"
        android:textStyle="bold" />

</LinearLayout>
