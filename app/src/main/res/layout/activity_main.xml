<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0000"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="PARAGON"
            android:textColor="#FF1A1A"
            android:textSize="34sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif"
            android:letterSpacing="3"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🐉"
            android:textSize="28sp"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NAGA"
            android:textColor="#FFD700"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif"/>

    </LinearLayout>

    <!-- BADGE -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/dragon_card_bg"
        android:padding="6dp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:layout_marginBottom="20dp"
        android:radius="20dp"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🐉"
            android:textSize="14sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DRAGON"
            android:textColor="#FF1A1A"
            android:textSize="10sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.5"/>

    </LinearLayout>

    <!-- TITLE -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DASHBOARD"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif"
        android:layout_marginBottom="20dp"
        android:letterSpacing="0.5"/>

    <!-- STATISTIK -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/dragon_card_bg"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginEnd="8dp"
            android:gravity="center"
            android:radius="14dp"
            android:elevation="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3"
                android:textColor="#FF1A1A"
                android:textSize="26sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Online"
                android:textColor="#8B0000"
                android:textSize="10sp"
                android:fontFamily="sans-serif"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● LIVE"
                android:textColor="#FF1A1A"
                android:textSize="8sp"
                android:fontFamily="sans-serif"
                android:background="#FF1A1A22"
                android:padding="2dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:radius="4dp"
                android:layout_marginTop="4dp"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/dragon_card_bg"
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center"
            android:radius="14dp"
            android:elevation="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sender"
                android:textColor="#8B0000"
                android:textSize="10sp"
                android:fontFamily="sans-serif"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/dragon_card_bg"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:radius="14dp"
            android:elevation="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="31/12/2099"
                android:textColor="#FFD700"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Expired"
                android:textColor="#8B0000"
                android:textSize="10sp"
                android:fontFamily="sans-serif"/>

        </LinearLayout>

    </LinearLayout>

    <!-- RAT BUTTON -->
    <Button
        android:id="@+id/btnRAT"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/dragon_btn"
        android:text="🐉 RAT - CONTROL"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif"
        android:radius="25dp"
        android:elevation="6dp"
        android:layout_marginBottom="10dp"/>

    <!-- APP BUILD BUTTON -->
    <Button
        android:id="@+id/btnAppBuild"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/dragon_btn"
        android:text="🐉 APP BUILD"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif"
        android:radius="25dp"
        android:elevation="6dp"
        android:layout_marginBottom="20dp"/>

    <!-- BOTTOM NAV -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="0dp"
        android:background="@drawable/dragon_card_bg"
        android:radius="14dp"
        android:padding="4dp"
        android:elevation="6dp">

        <TextView
            android:id="@+id/navBeranda"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Beranda"
            android:textColor="#FF1A1A"
            android:textSize="11sp"
            android:gravity="center"
            android:background="#1A0000"
            android:radius="12dp"
            android:fontFamily="sans-serif"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/navMenu"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Menu"
            android:textColor="#8B0000"
            android:textSize="11sp"
            android:gravity="center"
            android:fontFamily="sans-serif"/>

        <TextView
            android:id="@+id/navTools"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Tools"
            android:textColor="#8B0000"
            android:textSize="11sp"
            android:gravity="center"
            android:fontFamily="sans-serif"/>

        <TextView
            android:id="@+id/navSetting"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Setting"
            android:textColor="#8B0000"
            android:textSize="11sp"
            android:gravity="center"
            android:fontFamily="sans-serif"/>

    </LinearLayout>

</LinearLayout>
