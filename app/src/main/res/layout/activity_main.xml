<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E1A"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SYAM"
            android:textColor="#00E5FF"
            android:textSize="28sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ahlan Wa Sahlan,"
            android:textColor="#7A8A9E"
            android:textSize="11sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" syam"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#141E33"
        android:padding="6dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginBottom="20dp"
        android:radius="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ PEMULA"
            android:textColor="#00E5FF"
            android:textSize="10sp"
            android:textStyle="bold"/>

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SYAM DASHBOARD"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="#121C30"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginEnd="8dp"
            android:gravity="center"
            android:radius="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3"
                android:textColor="#00E5FF"
                android:textSize="26sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Online"
                android:textColor="#7A8A9E"
                android:textSize="10sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LIVE"
                android:textColor="#FF4444"
                android:textSize="8sp"
                android:background="#FF444422"
                android:padding="2dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:radius="4dp"
                android:layout_marginTop="4dp"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="#121C30"
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center"
            android:radius="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sender"
                android:textColor="#7A8A9E"
                android:textSize="10sp"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="#121C30"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:radius="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="31/12/2099"
                android:textColor="#F59E0B"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Expired"
                android:textColor="#7A8A9E"
                android:textSize="10sp"/>

        </LinearLayout>

    </LinearLayout>

    <Button
        android:id="@+id/btnAppBuild"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/btn_gradient"
        android:text="🔧 APP BUILD"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:radius="25dp"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp">

        <Button
            android:id="@+id/btnGuideTermux"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/btn_gradient"
            android:text="GUIDE TERMUX"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginEnd="8dp"
            android:radius="22dp"/>

        <Button
            android:id="@+id/btnGuideVps"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/btn_outline"
            android:text="GUIDE VPS"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp"
            android:radius="22dp"/>

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AERITA TERKINI"
        android:textColor="#00E5FF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="14dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/menuContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>

    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="12dp"
        android:background="#121C30"
        android:radius="14dp"
        android:padding="4dp">

        <TextView
            android:id="@+id/navBeranda"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="Beranda"
            android:textColor="#00E5FF"
            android:textSize="11sp"
            android:gravity="center"
            android:background="#1A263A"
            android:radius="10dp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/navMenu"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="Menu"
            android:textColor="#7A8A9E"
            android:textSize="11sp"
            android:gravity="center"/>

        <TextView
            android:id="@+id/navTools"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="Tools"
            android:textColor="#7A8A9E"
            android:textSize="11sp"
            android:gravity="center"/>

        <TextView
            android:id="@+id/navSetting"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="Setting"
            android:textColor="#7A8A9E"
            android:textSize="11sp"
            android:gravity="center"/>

    </LinearLayout>

</LinearLayout>
