<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="KONTROL DEVICE"
        android:textColor="#00FF41"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btnGanti"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="GANTI TARGET"
        android:textColor="#00FF41"
        android:background="@drawable/tombol_border"
        android:layout_marginBottom="16dp"/>

    <Switch
        android:id="@+id/swLockScreen"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Lock Screen"
        android:textColor="#FFFFFF"
        android:thumbTint="#FF1744"
        android:trackTint="#333333"/>

</LinearLayout>
